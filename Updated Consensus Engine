        Ok(true)
    }
}

// Message handlers
struct ProposalHandler {
    engine: Arc<ConsensusEngine>,
}

#[async_trait]
impl MessageHandler for ProposalHandler {
    async fn handle(&self, msg: ConsensusMessage, from: lib_network::PeerId) -> Result<Option<ConsensusMessage>> {
        let start = Instant::now();
        
        // Process proposal
        // ... existing proposal processing logic ...
        
        self.engine.metrics.observe_proposal_time(start.elapsed());
        self.engine.metrics.inc_messages_received();
        
        Ok(None) // No response needed
    }
    
    fn message_type(&self) -> ConsensusMessageType {
        ConsensusMessageType::Proposal
    }
}

